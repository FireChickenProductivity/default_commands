# Safari
os: mac
app.bundle: com.apple.Safari
-
close tab:
    # help: Close the current browser tab
    key(cmd-w)
go back:
    # help: Go back to the previous webpage
    # TODO: close/unfocus sub-UI?
    key(cmd-[)
go forward:
    # help: Return to the webpage you went back from
    key(cmd-])
new tab:
    # help: Open a new browser tab
    key(cmd-t)
search now:
    # help: Press the return/enter key
    key(enter)
zoom in:
    # help: Zoom in
    key(cmd-=)
zoom out:
    # help: Zoom out
    key(cmd--)
